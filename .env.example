# AnythingLLM connection — copy to .env and fill in.
ANYTHINGLLM_URL=http://127.0.0.1:3001
ANYTHINGLLM_API_KEY=

# Optional tuning
# ANYTHINGLLM_TIMEOUT_SECONDS=180
# ANYTHINGLLM_SCORE_THRESHOLD=0.5
# ANYTHINGLLM_TOP_N=6

# AnythingLLM's storage/documents folder (enables rag_get; the API returns no document text)
# ANYTHINGLLM_DOCUMENTS_DIR=/opt/anythingllm/storage/documents

# Log level
# LOG_LEVEL=INFO
